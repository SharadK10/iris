# Iris production settings. Copy to /opt/iris/iris.env, fill in, then: chmod 600 iris.env
# Never commit the filled-in file. Redis host/port are set in docker-compose.yml.

# Where the web app lives; the API only accepts browser and WebSocket requests from here.
FRONTEND_ORIGIN=https://iris.liv2code.in

# YouTube Data API key, for search.
YOUTUBE_API_KEY=
