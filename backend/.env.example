# Copy to backend/.env and fill in real values (backend/.env is gitignored).
# Load before running the backend, e.g.:
#   set -a; source backend/.env; set +a
YOUTUBE_API_KEY=your-youtube-data-api-key

# Postgres — durable store for "pressed" (paid, permanent) letters.
# Point this at any running Postgres; tables are created automatically on boot.
DATABASE_URL=jdbc:postgresql://localhost:5432/iris
DATABASE_USER=iris
DATABASE_PASSWORD=iris

# Razorpay — pressing a letter (pay to keep it forever).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# One-time press price, in the smallest currency unit (paise for INR). 4900 = ₹49.
LETTER_PRESS_AMOUNT_PAISE=4900
LETTER_PRESS_CURRENCY=INR
